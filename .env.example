MONGODB_URI="your_mongodb_atlas_connection_string"

# AI — Google Gemini is the primary backend (replaces the legacy Groq/Grok
# integration). Without a key the app falls back to deterministic local logic.
GEMINI_API_KEY="your_gemini_api_key"
GEMINI_MODEL="gemini-2.0-flash"

# Optional secondary backend (used only if GEMINI_API_KEY is absent)
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="meta-llama/llama-3.3-70b-instruct:free"

APP_URL="http://localhost:5000"

ML_ENABLED="true"

# Auth / role-based access
SECRET_KEY="change-me-in-production"

# Multi-user platform
# DEV_MODE="true" enables dev shortcuts (quick sign-in demo shortcut); it does
# NOT auto-approve providers/resources — approval is always Admin-driven.
DEV_MODE="true"

# Google Maps (optional — add your key to enable pickers, never commit it)
GOOGLE_MAPS_API_KEY=""
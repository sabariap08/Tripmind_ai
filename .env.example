MONGODB_URI="your_mongodb_atlas_connection_string"

# AI — Ollama cloud is the primary backend (fast cloud models on ollama.com),
# then Gemini, then Cerebras, then OpenRouter (free-tier fallback). Without a
# key the app has no live AI backend and signals unavailability (never
# fabricates plans).
OLLAMA_API_KEY=""
OLLAMA_MODEL="gpt-oss:120b"

# Google Gemini (optional secondary)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-flash-latest"

# Cerebras (OpenAI-compatible fallback)
CEREBRAS_API_KEY=""
CEREBRAS_MODEL="gpt-oss-120b"

# OpenRouter free-tier fallback (used only if the above are absent)
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free"

APP_URL="http://localhost:5000"

ML_ENABLED="true"

# Auth / role-based access
SECRET_KEY="change-me-in-production"

# Multi-user platform
# DEV_MODE="true" enables dev shortcuts (quick sign-in demo shortcut); it does
# NOT auto-approve providers/resources — approval is always Admin-driven.
DEV_MODE="true"

# Google Maps (optional — add your key to enable pickers, never commit it)
GOOGLE_MAPS_API_KEY=""